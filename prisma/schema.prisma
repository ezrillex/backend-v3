generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostTypes {
  Video
  Short
  Image
  Text
  ImageText
  Audio
}

enum VideoTypes {
  HostedVideo
  YoutubeRepost
}

enum Prefixes {
  img
  wtt
}

model Channels {
  id String @id @default(uuid(7)) @db.Uuid

  name  String
  posts Posts[]

  avatarFile   ManagedFile? @relation(fields: [avatarFileId], references: [id])
  avatarFileId String?      @db.Uuid

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique // db uuid mismatch with id is string.

  @@index([avatarFileId]) // join/include avatar
}

model Posts {
  id   String    @id @default(uuid(7)) @db.Uuid
  type PostTypes

  channels   Channels @relation(fields: [channelsId], references: [id])
  channelsId String   @db.Uuid

  title     String? // nullable due to text posts not required.
  published Boolean @default(false)
  kilobytes Int     @default(0) // some items like text will be set to 0 so this default is ok

  likes BigInt @default(0)
  views BigInt @default(0)

  createdAt   DateTime @default(now())
  publishedAt DateTime @default(now())

  video     VideoPost? // implemented yes
  image     ImagePost?
  text      TextPost? // implemented yes
  imageText ImageTextPost?
  audio     AudioPost?

  @@index([createdAt])
  @@index([id])
}

model VideoPost {
  id          String     @id @default(uuid(7)) @db.Uuid
  type        VideoTypes
  mediaUrl    String? // only for reposted videos, this is yt link not managed file bucket link
  description String
  duration    String? // null for hosted(until submission). required for repost yt. (got from api)

  post   Posts  @relation(fields: [postId], references: [id])
  postId String @unique @db.Uuid

  webseeds WebSeeds[]

  torrentFile   ManagedFile? @relation("torrents", fields: [torrentFileId], references: [id])
  torrentFileId String?      @db.Uuid

  thumbnailFile   ManagedFile @relation("thumbnails", fields: [thumbnailFileId], references: [id])
  thumbnailFileId String      @db.Uuid
}

model TextPost {
  id     String @id @default(uuid(7)) @db.Uuid
  text   String
  post   Posts  @relation(fields: [postId], references: [id])
  postId String @unique @db.Uuid
}

model ManagedFile {
  id     String   @id @default(uuid(7)) @db.Uuid
  prefix Prefixes
  hash   String   @unique

  thumbnails VideoPost[] @relation("thumbnails")
  torrents   VideoPost[] @relation("torrents")
  avatars    Channels[]
}

//tbd

model ImagePost {
  id     String @id @default(uuid(7)) @db.Uuid
  url    String
  post   Posts  @relation(fields: [postId], references: [id])
  postId String @unique @db.Uuid
}

// tbd

model ImageTextPost {
  id     String @id @default(uuid(7)) @db.Uuid
  url    String
  text   String
  post   Posts  @relation(fields: [postId], references: [id])
  postId String @unique @db.Uuid
}

// tbd

model AudioPost {
  id     String @id @default(uuid(7)) @db.Uuid
  url    String
  post   Posts  @relation(fields: [postId], references: [id])
  postId String @unique @db.Uuid
}

model WebSeedProviders {
  id       String     @id @default(uuid(7)) @db.Uuid
  basePath String
  enabled  Boolean    @default(false)
  seeds    WebSeeds[]
}

model WebSeeds {
  id   String @id @default(uuid(7)) @db.Uuid
  slug String

  provider   WebSeedProviders @relation(fields: [providerId], references: [id])
  providerId String           @db.Uuid

  video   VideoPost @relation(fields: [videoId], references: [id])
  videoId String    @db.Uuid
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  channel       Channels? // todo crear al mismo tiempo en api.

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}
