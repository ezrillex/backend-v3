// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostTypes {
  Video
  Short
  Image
  Text
  ImageText
  Audio
}

enum VideoTypes {
  HostedVideo
  YoutubeRepost
}

model Channels {
  id      String  @id @default(uuid(7)) @db.Uuid
  clerkId String  @default("") // todo remove default
  name    String  @default("Nuevo Canal") // todo when resetting delete default
  avatar  String  @default("") // todo remove default
  posts   Posts[]

  // todo index clerk id
}

model Posts {
  id   String    @id @default(uuid(7)) @db.Uuid
  type PostTypes

  channels   Channels @relation(fields: [channelsId], references: [id])
  channelsId String   @db.Uuid

  title     String  @default("Titulo Predeterminado") // todo remove this
  published Boolean @default(false)
  kilobytes Int     @default(0) // some items like text will be set to 0 so this default is ok

  likes       BigInt   @default(0)
  createdAt   DateTime @default(now())
  publishedAt DateTime @default(now())

  video     VideoPost?
  short     ShortPost?
  image     ImagePost?
  text      TextPost?
  imageText ImageTextPost?
  audio     AudioPost?
}

model VideoPost {
  id          String     @id @default(uuid(7)) @db.Uuid
  type        VideoTypes @default(HostedVideo) // todo maybe able to remove on startover
  mediaUrl    String // does this also applies for torrents?
  description String
  duration    String     @default("12:34") // todo for real one remove defaults.
  thumbnail   String     @default("") // todo remove default
  views       BigInt     @default(0)
  post        Posts      @relation(fields: [postId], references: [id])
  postId      String     @unique @db.Uuid
}

model ShortPost {
  id       String @id @default(uuid(7)) @db.Uuid
  mediaUrl String
  // tbd
  post     Posts  @relation(fields: [postId], references: [id])
  postId   String @unique @db.Uuid
}

//tbd
model ImagePost {
  id     String @id @default(uuid(7)) @db.Uuid
  url    String
  post   Posts  @relation(fields: [postId], references: [id])
  postId String @unique @db.Uuid
}

//tbd
model TextPost {
  id     String @id @default(uuid(7)) @db.Uuid
  text   String
  post   Posts  @relation(fields: [postId], references: [id])
  postId String @unique @db.Uuid
}

// tbd
model ImageTextPost {
  id     String @id @default(uuid(7)) @db.Uuid
  url    String
  text   String
  post   Posts  @relation(fields: [postId], references: [id])
  postId String @unique @db.Uuid
}

// tbd
model AudioPost {
  id     String @id @default(uuid(7)) @db.Uuid
  url    String
  post   Posts  @relation(fields: [postId], references: [id])
  postId String @unique @db.Uuid
}
